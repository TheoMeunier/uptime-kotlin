---
import MainLayout from "../layouts/Layout.astro";

import BackgroundGlow from "../components/BackgroundGlow.astro";
import Navbar from "../components/Navbar.astro";
import Hero from "../components/Hero.astro";
import Exemple from "../components/Exemple.astro";
import Features from "../components/Features.astro";
import Footer from "../components/Footer.astro";
import Installation from "../components/Installation.astro";
---

<MainLayout
        title="uptime-kotlin"
        description="Modern open-source uptime monitoring platform built with Kotlin."
        canonicalUrl="https://uptime-kotlin.com"
        ogImage="/favicon.png"
>
    <BackgroundGlow/>
    <Navbar/>

    <main>
        <Hero/>
        <Features/>
        <Exemple/>
        <Installation/>
    </main>

    <Footer/>
</MainLayout>