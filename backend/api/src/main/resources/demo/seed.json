      "retry": 1,
      "timeout": 10,
      "enabled": true,
      "log_retention_days": 30
    },
    {
      "name": "Cloudflare DNS (TCP 443)",
      "description": "Opens a TCP connection to 1.1.1.1 on port 443.",
      "protocol": "TCP",
      "interval": 60,
      "interval_retry": 30,
      "retry": 2,
      "timeout": 5,
      "enabled": true,
      "log_retention_days": 30,
      "url": "1.1.1.1",
      "tcp_port": 443
    },
    {
      "name": "Google DNS resolution",
      "description": "Resolves the A record of google.com through 8.8.8.8.",
      "protocol": "DNS",
      "interval": 120,
      "interval_retry": 30,
      "retry": 2,
      "timeout": 5,
      "enabled": true,
      "log_retention_days": 30,
      "hostname": "google.com",
      "dns_server": "8.8.8.8",
      "dns_port": 53,
      "record_type": "A"
    },
    {
      "name": "Google Public DNS (ping)",
      "description": "Three ICMP echo requests to 8.8.8.8.",
      "protocol": "PING",
      "interval": 60,
      "interval_retry": 30,
      "retry": 2,
      "timeout": 5,
      "enabled": true,
      "log_retention_days": 30,
      "ip": "8.8.8.8",
      "ping_heartbeat_interval": 1,
      "ping_max_packet": 3,
      "ping_size": 56,
      "ping_delay": 50,
      "ping_numeric_output": true
    },
    {
      "name": "Gmail SMTP",
      "description": "SMTP handshake with smtp.gmail.com on port 587 (STARTTLS).",
      "protocol": "SMTP",
      "interval": 300,
      "interval_retry": 30,
      "retry": 2,
      "timeout": 10,
      "enabled": true,
      "log_retention_days": 30,
      "hostname": "smtp.gmail.com",
      "port": 587,
      "security": "STARTTLS"
    },
    {
      "name": "Twitter / X (paused)",
      "description": "A paused probe: kept, but not checked.",
      "protocol": "HTTP",
      "url": "https://x.com",
      "method": "GET",
      "http_code_allowed": [
        "200-299"
      ],
